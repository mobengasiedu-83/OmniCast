APP_NAME="SysUp360 OmniCast"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost/gwosevo-omnicast/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gwosevo_omnicast
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Delivery queues. Horizon only supervises the `redis` connection, so every
# environment dispatches to redis and `composer run dev` starts `php artisan
# horizon` alongside `php artisan schedule:work`. A `database` queue works too,
# but then run `php artisan queue:work` instead of Horizon.
QUEUE_CONNECTION=redis

# Multi-channel campaigns orchestrate on QUEUE_CAMPAIGNS; a single-channel
# campaign and its retries stay on QUEUE_SMS / QUEUE_VOICE / QUEUE_EMAIL.
QUEUE_CAMPAIGNS=campaigns
QUEUE_SMS=sms
QUEUE_VOICE=voice
QUEUE_EMAIL=email
QUEUE_SMS_TRIES=3
QUEUE_SMS_TIMEOUT=120
QUEUE_VOICE_TRIES=3
QUEUE_VOICE_TIMEOUT=300
QUEUE_EMAIL_TRIES=3
QUEUE_EMAIL_TIMEOUT=180
QUEUE_CAMPAIGN_TRIES=3
QUEUE_CAMPAIGN_TIMEOUT=900

# Submissions per second per channel. Zero means unthrottled; a client or the
# platform `rate_limits.<channel>_cps` setting overrides the ceiling.
SMS_BROADCAST_GLOBAL_CPS=0
VOICE_BROADCAST_GLOBAL_CPS=0
EMAIL_BROADCAST_GLOBAL_CPS=0

# A running campaign that has not moved for this long is re-queued by
# `campaigns:sweep` (never sooner than its own retry delay plus five minutes).
# Failed jobs are kept for QUEUE_FAILED_PRUNE_HOURS before the nightly prune.
CAMPAIGN_STALLED_AFTER_MINUTES=15
CAMPAIGN_SWEEP_LIMIT=50
QUEUE_FAILED_PRUNE_HOURS=168

# Horizon dashboard: HORIZON_PATH (default `horizon`). Access is limited to a
# platform user holding the `queues.view` permission.
HORIZON_PATH=horizon

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# DreamHost outbound SMTP. The username is the full DreamHost mailbox address and the
# password is that mailbox's password from the DreamHost panel (Mail > Manage Mailboxes),
# not the panel login. Use MAIL_PORT=465 + MAIL_SCHEME=smtps for implicit TLS.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=

# Campaign email broadcast relay (EMAIL_BROADCAST_DRIVER=smtp). This mail server
# accepts unauthenticated plaintext mail, so username, password and scheme are
# left empty; the message is submitted through the `broadcast` mailer in
# config/mail.php rather than the transactional mailer above.
EMAIL_BROADCAST_DRIVER=smtp
EMAIL_BROADCAST_ENABLED=true
EMAIL_BROADCAST_MAILER=broadcast
MAIL_BROADCAST_HOST=62.129.149.147
MAIL_BROADCAST_PORT=2525
MAIL_BROADCAST_USERNAME=
MAIL_BROADCAST_PASSWORD=
MAIL_BROADCAST_SCHEME=
MAIL_BROADCAST_TIMEOUT=15
MAIL_BROADCAST_EHLO_DOMAIN=
MAIL_BROADCAST_FROM_ADDRESS="noreply@sysup360.com"
MAIL_BROADCAST_FROM_NAME="${APP_NAME}"
# Shared secret the mail server signs delivery/bounce feedback with.
EMAIL_WEBHOOK_SECRET=

# Generic JSON email provider (EMAIL_BROADCAST_DRIVER=generic_json).
EMAIL_GENERIC_ENDPOINT=
EMAIL_GENERIC_TOKEN=
EMAIL_GENERIC_USERNAME=
EMAIL_GENERIC_PASSWORD=

# TxtConnect SMS OTP provider. Set SMS_TOKEN from the provider dashboard.
SMS_DRIVER=txtconnect
SMS_ENDPOINT=https://api.txtconnect.net/dev/api/sms/send
SMS_TOKEN=
SMS_SENDER_ID=OmniCast

# Sender ID limits enforced on the request form and during validation.
# SMS sender IDs are case-preserving and count spaces in the length.
SMS_SENDER_ID_MIN_LENGTH=3
SMS_SENDER_ID_MAX_LENGTH=11
SMS_SENDER_ID_ALLOW_SPACES=true
EMAIL_SENDER_ID_MAX_LENGTH=120

# Campaign delivery gates. Left off, a campaign launches by itself as soon as
# its sender ID (SMS/email) or audio (voice) is approved.
CAMPAIGNS_REQUIRE_APPROVAL=false
CAMPAIGNS_REQUIRE_APPROVED_AUDIO=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The Vite build reads this file itself, so `${APP_NAME}` is not expanded here.
# Keep the name spelled out and rebuild after changing it.
VITE_APP_NAME="SysUp360 OmniCast"

# Path prefix the frontend is built for: the deploy's sub-directory, or empty
# when the app is served from the root of its domain. Rebuild after changing.
VITE_APP_BASE_PATH=/gwosevo-omnicast/public

# Phase 1: private AMI connection; use a dedicated account with minimum required permissions.
VITALPBX_AMI_HOST=
VITALPBX_AMI_PORT=5038
VITALPBX_AMI_USERNAME=
VITALPBX_AMI_SECRET=

# Populate only from recorded discovery evidence. Unknown limits block readiness.
VITALPBX_VERSION=
ASTERISK_VERSION=

# Exact PJSIP endpoint ID, which may differ from the VitalPBX display name.
VITALPBX_TRUNK_NAME=
VITALPBX_CALLER_ID=
# national: 0..., international: 233..., e164: +233...
VITALPBX_NUMBER_FORMAT=e164
VITALPBX_DIAL_PATTERN=
VITALPBX_BROADCAST_CONTEXT=
VITALPBX_CARRIER_CHANNELS=
VITALPBX_CARRIER_CPS=
VITALPBX_RESERVED_CHANNELS=
VITALPBX_SAFE_PBX_CHANNELS=
VITALPBX_BROADCAST_CAP=
VITALPBX_DISCOVERY_EVIDENCE=

# Enable only after PBX dialplan/audio installation, carrier approval and controlled UAT.
# The per-second ceiling sits in the delivery queue block above
# (VOICE_BROADCAST_GLOBAL_CPS).
VOICE_BROADCAST_ENABLED=false
VOICE_BROADCAST_GLOBAL_CHANNELS=0

# Application-hosted recordings: PBX must reach this HTTP(S) base URL.
VOICE_BROADCAST_MEDIA_MODE=pbx
VOICE_BROADCAST_MEDIA_BASE_URL=

# The single DID every voice campaign dials from (outbound caller ID).
# Override at runtime with the `voice.outbound_caller_id` platform setting.
VOICE_OUTBOUND_CALLER_ID=

# Voice transport: log (development), ami (Asterisk Manager Interface) or ari (Asterisk REST Interface).
# ami/ari only dial when VOICE_BROADCAST_ENABLED=true.
VOICE_DRIVER=log
VITALPBX_AMI_TIMEOUT=5
VITALPBX_ARI_URL=http://127.0.0.1:8088/ari
VITALPBX_ARI_USERNAME=
VITALPBX_ARI_SECRET=
VITALPBX_ARI_APP=omnicast
VITALPBX_ARI_ENDPOINT=PJSIP
VITALPBX_ARI_TIMEOUT=10

# Shared secret for switch callbacks. The PBX signs the raw body with HMAC-SHA256
# and sends it in X-Omnicast-Signature; callbacks are refused while this is empty.
VOICE_WEBHOOK_SECRET=

# Default DTMF menu: press 1 to listen, 2 to repeat, 9 to opt out.
VOICE_IVR_TIMEOUT_SECONDS=6
VOICE_IVR_MAX_ATTEMPTS=3
VOICE_IVR_OPT_OUT_DIGIT=9

# SMS transport: log (development), txtconnect or generic_json.
# Live transports only submit when SMS_BROADCAST_ENABLED=true. The per-second
# ceiling sits in the delivery queue block above (SMS_BROADCAST_GLOBAL_CPS).
SMS_BROADCAST_DRIVER=log
SMS_BROADCAST_ENABLED=false

# Shared secret for delivery receipts posted to /webhooks/sms. A POST body is
# signed in X-Omnicast-Signature, a GET receipt (provider dlr-url) signs its reference
# in `sig`; receipts are refused while this is empty.
SMS_WEBHOOK_SECRET=

# Generic JSON aggregator (bearer token, or basic credentials).
SMS_GENERIC_ENDPOINT=
SMS_GENERIC_TOKEN=
SMS_GENERIC_USERNAME=
SMS_GENERIC_PASSWORD=


# Wallet funding. BILLING_DRIVER=log settles a top up without moving money and
# is the setting to use until a live Paystack key is in place; `paystack`
# redirects the client to the hosted checkout.
BILLING_DRIVER=log
BILLING_CURRENCY=GHS
BILLING_SUPPORT_EMAIL=billing@sysup360.com
BILLING_MIN_TOP_UP=1
BILLING_MAX_TOP_UP=100000
# Optional JSON catalogue overriding the config/billing.php packages.
BILLING_PACKAGES=

# The letterhead printed on the invoice PDF a client downloads. The name falls
# back to APP_NAME and the e-mail to BILLING_SUPPORT_EMAIL, so only the
# registered company details need filling in.
BILLING_ISSUER_NAME=
BILLING_ISSUER_ADDRESS=Accra, Ghana
BILLING_ISSUER_PHONE=
BILLING_ISSUER_EMAIL=
BILLING_ISSUER_WEBSITE=

# Paystack integration. The webhook signs the raw body with HMAC-SHA512 in
# X-Paystack-Signature; PAYSTACK_WEBHOOK_SECRET falls back to the secret key.
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CHANNELS=card,mobile_money,bank_transfer
PAYSTACK_TIMEOUT=20

# Reporting. Exports are written to REPORTS_EXPORT_DISK at REPORTS_EXPORT_PATH
# and deleted after REPORTS_EXPORT_RETENTION_DAYS. `reports:aggregate` rebuilds
# the last REPORTS_AGGREGATE_WINDOW_DAYS days of rollups every hour.
REPORTS_DEFAULT_WINDOW_DAYS=30
REPORTS_EXPORT_DISK=local
REPORTS_EXPORT_PATH=reports
REPORTS_EXPORT_MAX_ROWS=50000
REPORTS_EXPORT_RETENTION_DAYS=30
REPORTS_AGGREGATE_WINDOW_DAYS=7
REPORTS_RECONCILIATION_TOLERANCE=0.01

# Scheduled report: `weekly` mails the previous week, `monthly` the previous
# month. Client admins always receive their own overview; these recipients get
# the platform executive summary. Keep it off until the mailer is configured.
REPORTS_SCHEDULED_ENABLED=false
REPORTS_SCHEDULED_FREQUENCY=weekly
REPORTS_SCHEDULED_RECIPIENTS=

# Cloudflare Turnstile guards the sign-in form. Leave TURNSTILE_ENABLED off for
# local work and the test suite: the challenge is only armed when the flag is
# on and both keys are filled in. Create the keys at
# https://dash.cloudflare.com/?to=/:account/turnstile (the test keys
# 1x00000000000000000000AA / 1x0000000000000000000000000000000AA always pass).
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT=10

