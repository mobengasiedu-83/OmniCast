APP_NAME="GWO SEVO OmniCast"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost/gwosevo-omnicast/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gwosevo_omnicast
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail / Google Workspace SMTP. Replace the app password with a Google App Password
# (2-Step Verification must be on). Use MAIL_PORT=465 + MAIL_SCHEME=smtps for implicit TLS.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="you@gmail.com"
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="you@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=

# TxtConnect SMS OTP provider. Set SMS_TOKEN from the provider dashboard.
SMS_DRIVER=txtconnect
SMS_ENDPOINT=https://api.txtconnect.net/dev/api/sms/send
SMS_TOKEN=
SMS_SENDER_ID=OmniCast

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phase 1: private AMI connection; use a dedicated account with minimum required permissions.
VITALPBX_AMI_HOST=
VITALPBX_AMI_PORT=5038
VITALPBX_AMI_USERNAME=
VITALPBX_AMI_SECRET=

# Populate only from recorded discovery evidence. Unknown limits block readiness.
VITALPBX_VERSION=
ASTERISK_VERSION=

# Exact PJSIP endpoint ID, which may differ from the VitalPBX display name.
VITALPBX_TRUNK_NAME=
VITALPBX_CALLER_ID=
# national: 0..., international: 233..., e164: +233...
VITALPBX_NUMBER_FORMAT=e164
VITALPBX_DIAL_PATTERN=
VITALPBX_BROADCAST_CONTEXT=
VITALPBX_CARRIER_CHANNELS=
VITALPBX_CARRIER_CPS=
VITALPBX_RESERVED_CHANNELS=
VITALPBX_SAFE_PBX_CHANNELS=
VITALPBX_BROADCAST_CAP=
VITALPBX_DISCOVERY_EVIDENCE=

# Enable only after PBX dialplan/audio installation, carrier approval and controlled UAT.
VOICE_BROADCAST_ENABLED=false
VOICE_BROADCAST_GLOBAL_CHANNELS=0
VOICE_BROADCAST_GLOBAL_CPS=0

# Application-hosted recordings: PBX must reach this HTTP(S) base URL.
VOICE_BROADCAST_MEDIA_MODE=pbx
VOICE_BROADCAST_MEDIA_BASE_URL=
