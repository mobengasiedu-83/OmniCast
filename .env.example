APP_NAME="GWO SEVO OmniCast"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost/gwosevo-omnicast/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gwosevo_omnicast
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail / Google Workspace SMTP. Replace the app password with a Google App Password
# (2-Step Verification must be on). Use MAIL_PORT=465 + MAIL_SCHEME=smtps for implicit TLS.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="you@gmail.com"
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="you@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=

# Campaign email broadcast relay (EMAIL_BROADCAST_DRIVER=smtp). This mail server
# accepts unauthenticated plaintext mail, so username, password and scheme are
# left empty; the message is submitted through the `broadcast` mailer in
# config/mail.php rather than the transactional mailer above.
EMAIL_BROADCAST_DRIVER=smtp
EMAIL_BROADCAST_ENABLED=true
EMAIL_BROADCAST_MAILER=broadcast
MAIL_BROADCAST_HOST=62.129.149.147
MAIL_BROADCAST_PORT=2525
MAIL_BROADCAST_USERNAME=
MAIL_BROADCAST_PASSWORD=
MAIL_BROADCAST_SCHEME=
MAIL_BROADCAST_TIMEOUT=15
MAIL_BROADCAST_EHLO_DOMAIN=
MAIL_BROADCAST_FROM_ADDRESS="noreply@omnicast.gh"
MAIL_BROADCAST_FROM_NAME="${APP_NAME}"
# Shared secret the mail server signs delivery/bounce feedback with.
EMAIL_WEBHOOK_SECRET=

# Generic JSON email provider (EMAIL_BROADCAST_DRIVER=generic_json).
EMAIL_GENERIC_ENDPOINT=
EMAIL_GENERIC_TOKEN=
EMAIL_GENERIC_USERNAME=
EMAIL_GENERIC_PASSWORD=

# TxtConnect SMS OTP provider. Set SMS_TOKEN from the provider dashboard.
SMS_DRIVER=txtconnect
SMS_ENDPOINT=https://api.txtconnect.net/dev/api/sms/send
SMS_TOKEN=
SMS_SENDER_ID=OmniCast

# Sender ID limits enforced on the request form and during validation.
# SMS sender IDs are case-preserving and count spaces in the length.
SMS_SENDER_ID_MIN_LENGTH=3
SMS_SENDER_ID_MAX_LENGTH=11
SMS_SENDER_ID_ALLOW_SPACES=true
EMAIL_SENDER_ID_MAX_LENGTH=120

# Campaign delivery gates. Left off, a campaign launches by itself as soon as
# its sender ID (SMS/email) or audio (voice) is approved.
CAMPAIGNS_REQUIRE_APPROVAL=false
CAMPAIGNS_REQUIRE_APPROVED_SENDER_ID=true
CAMPAIGNS_REQUIRE_APPROVED_AUDIO=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phase 1: private AMI connection; use a dedicated account with minimum required permissions.
VITALPBX_AMI_HOST=
VITALPBX_AMI_PORT=5038
VITALPBX_AMI_USERNAME=
VITALPBX_AMI_SECRET=

# Populate only from recorded discovery evidence. Unknown limits block readiness.
VITALPBX_VERSION=
ASTERISK_VERSION=

# Exact PJSIP endpoint ID, which may differ from the VitalPBX display name.
VITALPBX_TRUNK_NAME=
VITALPBX_CALLER_ID=
# national: 0..., international: 233..., e164: +233...
VITALPBX_NUMBER_FORMAT=e164
VITALPBX_DIAL_PATTERN=
VITALPBX_BROADCAST_CONTEXT=
VITALPBX_CARRIER_CHANNELS=
VITALPBX_CARRIER_CPS=
VITALPBX_RESERVED_CHANNELS=
VITALPBX_SAFE_PBX_CHANNELS=
VITALPBX_BROADCAST_CAP=
VITALPBX_DISCOVERY_EVIDENCE=

# Enable only after PBX dialplan/audio installation, carrier approval and controlled UAT.
VOICE_BROADCAST_ENABLED=false
VOICE_BROADCAST_GLOBAL_CHANNELS=0
VOICE_BROADCAST_GLOBAL_CPS=0

# Application-hosted recordings: PBX must reach this HTTP(S) base URL.
VOICE_BROADCAST_MEDIA_MODE=pbx
VOICE_BROADCAST_MEDIA_BASE_URL=

# The single DID every voice campaign dials from (outbound caller ID).
# Override at runtime with the `voice.outbound_caller_id` platform setting.
VOICE_OUTBOUND_CALLER_ID=

# Voice transport: log (development), ami (Asterisk Manager Interface) or ari (Asterisk REST Interface).
# ami/ari only dial when VOICE_BROADCAST_ENABLED=true.
VOICE_DRIVER=log
VITALPBX_AMI_TIMEOUT=5
VITALPBX_ARI_URL=http://127.0.0.1:8088/ari
VITALPBX_ARI_USERNAME=
VITALPBX_ARI_SECRET=
VITALPBX_ARI_APP=omnicast
VITALPBX_ARI_ENDPOINT=PJSIP
VITALPBX_ARI_TIMEOUT=10

# Shared secret for switch callbacks. The PBX signs the raw body with HMAC-SHA256
# and sends it in X-Omnicast-Signature; callbacks are refused while this is empty.
VOICE_WEBHOOK_SECRET=

# Default DTMF menu: press 1 to listen, 2 to repeat, 9 to opt out.
VOICE_IVR_TIMEOUT_SECONDS=6
VOICE_IVR_MAX_ATTEMPTS=3
VOICE_IVR_OPT_OUT_DIGIT=9

# SMS transport: log (development), txtconnect, generic_json or kannel.
# Live transports only submit when SMS_BROADCAST_ENABLED=true.
SMS_BROADCAST_DRIVER=log
SMS_BROADCAST_ENABLED=false
SMS_BROADCAST_GLOBAL_CPS=0

# Shared secret for delivery receipts posted to /webhooks/sms. A POST body is
# signed in X-Omnicast-Signature, a GET receipt (Kannel dlr-url) signs its reference
# in `sig`; receipts are refused while this is empty.
SMS_WEBHOOK_SECRET=

# Generic JSON aggregator (bearer token, or basic credentials).
SMS_GENERIC_ENDPOINT=
SMS_GENERIC_TOKEN=
SMS_GENERIC_USERNAME=
SMS_GENERIC_PASSWORD=

# Kannel keeps the SMPP bind; OmniCast posts to its send-sms URL.
SMS_KANNEL_URL=
SMS_KANNEL_USERNAME=
SMS_KANNEL_PASSWORD=
SMS_KANNEL_DLR_MASK=31

