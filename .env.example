# SysUp360 OmniCast — environment template.
#
# Every variable the application reads is listed here with an empty value: copy
# this file to `.env` and fill in what the deployment needs. Defaults live in
# `config/*.php`, so an empty variable falls back to the documented default
# unless the config reads it with `?:` (the billing issuer block keeps its
# shipped fallback that way).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=
ASSET_URL=
APP_LOCALE=
APP_FALLBACK_LOCALE=
APP_FAKER_LOCALE=
APP_MAINTENANCE_DRIVER=
APP_MAINTENANCE_STORE=
# Comma-separated previous APP_KEY values that may still decrypt old payloads.
APP_PREVIOUS_KEYS=

# Vite reads this file itself (`${APP_NAME}` is not expanded here), so the
# frontend name and base path are set separately and need `npm run build`.
VITE_APP_NAME=
# Sub-directory the frontend is built for; empty when served from the root.
VITE_APP_BASE_PATH=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=
LOG_STACK=
LOG_DEPRECATIONS_CHANNEL=
LOG_DEPRECATIONS_TRACE=
LOG_LEVEL=
LOG_DAILY_DAYS=
# Slack log driver.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME=
LOG_SLACK_EMOJI=
# Papertrail log driver.
LOG_PAPERTRAIL_HANDLER=
PAPERTRAIL_URL=
PAPERTRAIL_PORT=
# stderr / syslog formatting.
LOG_STDERR_FORMATTER=
LOG_SYSLOG_FACILITY=

# ---------------------------------------------------------------------------
# Slack notifications (config/services.php slack block)
# ---------------------------------------------------------------------------
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=
# A full DSN overrides the individual settings below.
DB_URL=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=
DB_COLLATION=
# PostgreSQL / SQL Server.
DB_SSLMODE=
DB_ENCRYPT=
DB_TRUST_SERVER_CERTIFICATE=
# MySQL certificate authority bundle.
MYSQL_ATTR_SSL_CA=
DB_FOREIGN_KEYS=

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
SESSION_DRIVER=
SESSION_LIFETIME=
SESSION_ENCRYPT=
SESSION_PATH=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=
SESSION_SAME_SITE=
SESSION_PARTITIONED_COOKIE=
SESSION_EXPIRE_ON_CLOSE=
# Only used by the database / cache session drivers.
SESSION_CONNECTION=
SESSION_STORE=
SESSION_TABLE=

# ---------------------------------------------------------------------------
# Authentication, passkeys and API tokens
# ---------------------------------------------------------------------------
AUTH_GUARD=
AUTH_MODEL=
AUTH_PASSWORD_BROKER=
AUTH_PASSWORD_RESET_TOKEN_TABLE=
AUTH_PASSWORD_TIMEOUT=
# Key mixed into the passkey user handle; defaults to APP_KEY.
PASSKEYS_USER_HANDLE_SECRET=
# Comma-separated hostnames Sanctum treats as first-party.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
CACHE_STORE=
# Prefix applied to every cache key; empty derives it from APP_NAME.
CACHE_PREFIX=
# Directory of the `file` store, or the disk the `storage` store writes to.
CACHE_STORAGE_DISK=
CACHE_STORAGE_PATH=
MEMCACHED_HOST=
MEMCACHED_PORT=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=
REDIS_CACHE_CONNECTION=
REDIS_CACHE_LOCK_CONNECTION=
REDIS_CACHE_DB=
DYNAMODB_CACHE_TABLE=
DYNAMODB_ENDPOINT=

# ---------------------------------------------------------------------------
# Queues and delivery orchestration
# ---------------------------------------------------------------------------
# Horizon only supervises the `redis` connection, so every environment
# dispatches to redis and `composer run dev` starts `php artisan horizon`
# alongside `php artisan schedule:work`. With a `database` queue run
# `php artisan queue:work` instead of Horizon.
QUEUE_CONNECTION=
QUEUE_FAILED_DRIVER=
# Failed jobs are kept this many hours before the nightly prune.
QUEUE_FAILED_PRUNE_HOURS=

# Multi-channel campaigns orchestrate on QUEUE_CAMPAIGNS; a single-channel
# campaign and its retries stay on QUEUE_SMS / QUEUE_VOICE / QUEUE_EMAIL.
QUEUE_CAMPAIGNS=
QUEUE_SMS=
QUEUE_VOICE=
QUEUE_EMAIL=
QUEUE_WHATSAPP=
QUEUE_CAMPAIGN_TRIES=
QUEUE_CAMPAIGN_TIMEOUT=
QUEUE_SMS_TRIES=
QUEUE_SMS_TIMEOUT=
QUEUE_VOICE_TRIES=
QUEUE_VOICE_TIMEOUT=
QUEUE_EMAIL_TRIES=
QUEUE_EMAIL_TIMEOUT=
QUEUE_WHATSAPP_TRIES=
QUEUE_WHATSAPP_TIMEOUT=

# Keep provider credentials in each deployment's untracked .env or secret store.
# The base URL must be the origin only; endpoint paths are configured below.
WHATSAPP_ENABLED=false
WHATSAPP_API_BASE_URL=
WHATSAPP_API_CLIENT_ID=
WHATSAPP_API_KEY=
WHATSAPP_CONNECTORS_ENDPOINT=/api/whatsapp/v1/Connector/GetAll
WHATSAPP_TEMPLATE_ENDPOINT=/api/whatsapp/v1/Template/Get
WHATSAPP_TEMPLATES_ENDPOINT=/api/whatsapp/v1/Template/GetAll
WHATSAPP_SEND_ENDPOINT=/api/whatsapp/v1/Send
WHATSAPP_BROADCAST_GLOBAL_CPS=0

# Queue connection settings.
DB_QUEUE_CONNECTION=
DB_QUEUE=
DB_QUEUE_TABLE=
DB_QUEUE_RETRY_AFTER=
REDIS_QUEUE=
REDIS_QUEUE_CONNECTION=
REDIS_QUEUE_RETRY_AFTER=
SQS_QUEUE=
SQS_PREFIX=
SQS_SUFFIX=
BEANSTALKD_QUEUE_HOST=
BEANSTALKD_QUEUE=
BEANSTALKD_QUEUE_RETRY_AFTER=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_CLIENT=
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=
REDIS_PREFIX=
REDIS_PERSISTENT=
REDIS_CLUSTER=
REDIS_MAX_RETRIES=
REDIS_BACKOFF_ALGORITHM=
REDIS_BACKOFF_BASE=
REDIS_BACKOFF_CAP=

# ---------------------------------------------------------------------------
# Horizon dashboard
# ---------------------------------------------------------------------------
# HORIZON_PATH is the dashboard URL; access is limited to a platform user
# holding the `queues.view` permission.
HORIZON_NAME=
HORIZON_PATH=
HORIZON_DOMAIN=

# ---------------------------------------------------------------------------
# Filesystem
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=

# ---------------------------------------------------------------------------
# Transactional mail (password resets, receipts, scheduled reports)
# ---------------------------------------------------------------------------
MAIL_MAILER=
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_EHLO_DOMAIN=
MAIL_URL=
MAIL_SENDMAIL_PATH=
MAIL_LOG_CHANNEL=
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Email broadcasting
# ---------------------------------------------------------------------------
# EMAIL_BROADCAST_DRIVER: log | smtp | generic_json. The broadcast relay accepts
# unauthenticated plaintext mail, so username, password and scheme stay empty and
# the message goes through the `broadcast` mailer in config/mail.php.
EMAIL_BROADCAST_DRIVER=
EMAIL_BROADCAST_ENABLED=
EMAIL_BROADCAST_MAILER=
# Submissions per second across the platform; a client or the platform
# `rate_limits.email_cps` setting overrides it. Zero means unthrottled.
EMAIL_BROADCAST_GLOBAL_CPS=
EMAIL_WEBHOOK_SECRET=
EMAIL_SENDER_ID_MAX_LENGTH=
# Where stored attachments and inline images are written.
EMAIL_ATTACHMENT_DISK=
EMAIL_IMAGE_DISK=
# Generic JSON provider (bearer token, or basic credentials).
EMAIL_GENERIC_ENDPOINT=
EMAIL_GENERIC_TOKEN=
EMAIL_GENERIC_USERNAME=
EMAIL_GENERIC_PASSWORD=
# Campaign broadcast relay (the `broadcast` mailer). MAIL_BROADCAST_AUTO_TLS
# must stay off for a relay whose certificate cannot be verified: Symfony would
# otherwise send STARTTLS on every connect and reject the message.
MAIL_BROADCAST_HOST=
MAIL_BROADCAST_PORT=
MAIL_BROADCAST_USERNAME=
MAIL_BROADCAST_PASSWORD=
MAIL_BROADCAST_SCHEME=
MAIL_BROADCAST_AUTO_TLS=
MAIL_BROADCAST_TIMEOUT=
MAIL_BROADCAST_EHLO_DOMAIN=
MAIL_BROADCAST_FROM_ADDRESS=
MAIL_BROADCAST_FROM_NAME=

# ---------------------------------------------------------------------------
# SMS broadcasting
# ---------------------------------------------------------------------------
# SMS_BROADCAST_DRIVER: log | txtconnect | kannel | generic_json. Live
# transports only submit when SMS_BROADCAST_ENABLED is on.
SMS_BROADCAST_DRIVER=
SMS_BROADCAST_ENABLED=
SMS_BROADCAST_GLOBAL_CPS=
# SMS_DRIVER is the OTP transport: log | txtconnect | kannel | generic_json.
SMS_DRIVER=
SMS_ENDPOINT=
SMS_TOKEN=
# Kannel (also reached over SMPP).
SMS_KANNEL_URL=
SMS_KANNEL_USERNAME=
SMS_KANNEL_PASSWORD=
SMS_KANNEL_DLR_MASK=
# Generic JSON aggregator (bearer token, or basic credentials).
SMS_GENERIC_ENDPOINT=
SMS_GENERIC_TOKEN=
SMS_GENERIC_USERNAME=
SMS_GENERIC_PASSWORD=
# Sender IDs are case-preserving; SMS_SENDER_ID_ALLOW_SPACES decides whether a
# space counts towards the length limits.
SMS_SENDER_ID=
SMS_SENDER_ID_MIN_LENGTH=
SMS_SENDER_ID_MAX_LENGTH=
SMS_SENDER_ID_ALLOW_SPACES=
# Shared secret for receipts posted to /webhooks/sms: a POST body is signed in
# X-Omnicast-Signature, a GET receipt (provider dlr-url) signs its reference in
# `sig`. Receipts are refused while this is empty.
SMS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Voice broadcasting
# ---------------------------------------------------------------------------
# VOICE_DRIVER: log | ami | ari. ami/ari only dial when VOICE_BROADCAST_ENABLED
# is on.
VOICE_DRIVER=
VOICE_BROADCAST_ENABLED=
VOICE_BROADCAST_GLOBAL_CPS=
VOICE_BROADCAST_GLOBAL_CHANNELS=
# Application-hosted recordings: the PBX must reach this HTTP(S) base URL.
VOICE_BROADCAST_MEDIA_MODE=
VOICE_BROADCAST_MEDIA_BASE_URL=
VOICE_IVR_MAX_ATTEMPTS=
VOICE_IVR_OPT_OUT_DIGIT=
VOICE_IVR_TIMEOUT_SECONDS=
# The single DID every campaign dials from; the platform setting
# `voice.outbound_caller_id` overrides it at runtime.
VOICE_OUTBOUND_CALLER_ID=
# Shared secret for switch callbacks: the PBX signs the raw body with HMAC-SHA256.
VOICE_WEBHOOK_SECRET=
# VitalPBX / Asterisk endpoints. Use a dedicated AMI account with the minimum
# permissions, and the ARI app/endpoint the dialplan exposes.
VITALPBX_AMI_HOST=
VITALPBX_AMI_PORT=
VITALPBX_AMI_USERNAME=
VITALPBX_AMI_SECRET=
VITALPBX_AMI_TIMEOUT=
VITALPBX_TRUNK_NAME=
VITALPBX_BROADCAST_CONTEXT=
VITALPBX_ARI_URL=
VITALPBX_ARI_USERNAME=
VITALPBX_ARI_SECRET=
VITALPBX_ARI_APP=
VITALPBX_ARI_ENDPOINT=
VITALPBX_ARI_TIMEOUT=

# ---------------------------------------------------------------------------
# Campaign delivery gates
# ---------------------------------------------------------------------------
# Left off, a campaign launches by itself as soon as its sender ID (SMS/email)
# or audio (voice) is approved.
CAMPAIGNS_REQUIRE_APPROVAL=
CAMPAIGNS_REQUIRE_APPROVED_AUDIO=
# A running campaign that has not moved for this long is re-queued by
# `campaigns:sweep` (never sooner than its own retry delay plus five minutes).
CAMPAIGN_STALLED_AFTER_MINUTES=
CAMPAIGN_SWEEP_LIMIT=

# ---------------------------------------------------------------------------
# Billing, wallet and pricing
# ---------------------------------------------------------------------------
# BILLING_DRIVER: log settles a top up without moving money, paystack redirects
# the client to the hosted checkout.
BILLING_DRIVER=
BILLING_CURRENCY=
BILLING_SUPPORT_EMAIL=
BILLING_MIN_TOP_UP=
BILLING_MAX_TOP_UP=
# Optional JSON catalogue overriding the config/billing.php packages.
BILLING_PACKAGES=
# Credit estimator on the funding screen: per-unit channel rates and the slider
# bounds shown next to them.
BILLING_DYNAMIC_PRICING=
BILLING_RATE_SMS=
BILLING_RATE_VOICE=
BILLING_RATE_EMAIL=
BILLING_SLIDER_MIN=
BILLING_SLIDER_MAX=
BILLING_SLIDER_STEP=
BILLING_SLIDER_DEFAULT=
# Letterhead printed on the invoice PDF a client downloads; the name falls back
# to APP_NAME and the e-mail to BILLING_SUPPORT_EMAIL.
BILLING_ISSUER_NAME=
BILLING_ISSUER_ADDRESS=
BILLING_ISSUER_PHONE=
BILLING_ISSUER_EMAIL=
BILLING_ISSUER_WEBSITE=

# Paystack. The webhook signs the raw body with HMAC-SHA512 in
# X-Paystack-Signature; PAYSTACK_WEBHOOK_SECRET falls back to the secret key.
PAYSTACK_BASE_URL=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CHANNELS=
PAYSTACK_TIMEOUT=

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
# Exports are written to REPORTS_EXPORT_DISK at REPORTS_EXPORT_PATH. The
# REPORTS_EXPORT_RETENTION_DAYS value may extend (never shorten) a legally
# approved period; pruning is disabled until approved in Admin > Data retention.
# `reports:aggregate` rebuilds the last REPORTS_AGGREGATE_WINDOW_DAYS days hourly.
REPORTS_DEFAULT_WINDOW_DAYS=
REPORTS_EXPORT_DISK=
REPORTS_EXPORT_PATH=
REPORTS_EXPORT_MAX_ROWS=
REPORTS_EXPORT_RETENTION_DAYS=
REPORTS_AGGREGATE_WINDOW_DAYS=
REPORTS_RECONCILIATION_TOLERANCE=
# Scheduled report: weekly mails the previous week, monthly the previous month.
# Client admins always receive their own overview; these recipients get the
# platform executive summary.
REPORTS_SCHEDULED_ENABLED=
REPORTS_SCHEDULED_FREQUENCY=
REPORTS_SCHEDULED_RECIPIENTS=

# ---------------------------------------------------------------------------
# Versioned HTTP API (/api/v1)
# ---------------------------------------------------------------------------
# API_VERSION is reported by the public health probe and in
# X-Omnicast-Api-Version. A token holding the `write` ability is held to
# API_RATE_LIMIT_WRITE requests a minute, a `read` token to API_RATE_LIMIT_READ;
# the limiter buckets per token, so one integration cannot starve another.
API_VERSION=
API_PER_PAGE=
API_MAX_PER_PAGE=
API_RATE_LIMIT_READ=
API_RATE_LIMIT_WRITE=

# ---------------------------------------------------------------------------
# Outbound webhooks
# ---------------------------------------------------------------------------
# Every request is signed with
# X-Omnicast-Signature: t=<unix>,v1=<hmac-sha256(secret, "<unix>.<body>")>.
# A delivery is retried WEBHOOKS_TRIES times; an endpoint that fails
# WEBHOOKS_DISABLE_AFTER_FAILURES times in a row is switched off.
# WEBHOOKS_RETENTION_DAYS may extend (never shorten) an approved period;
# pruning stays disabled until legal approval in Admin > Data retention.
WEBHOOKS_ENABLED=
WEBHOOKS_QUEUE=
WEBHOOKS_TRIES=
WEBHOOKS_TIMEOUT=
WEBHOOKS_CONNECT_TIMEOUT=
WEBHOOKS_MAX_RESPONSE_BYTES=
WEBHOOKS_DISABLE_AFTER_FAILURES=
WEBHOOKS_USER_AGENT=
WEBHOOKS_SECRET_PREFIX=
WEBHOOKS_SIGNATURE_TOLERANCE=
WEBHOOKS_RETENTION_DAYS=

# ---------------------------------------------------------------------------
# SMPP server
# ---------------------------------------------------------------------------
# `php artisan sms:smpp-server` is a daemon: run it under supervisor next to the
# queue workers. With SMPP_SERVER_ENABLED off every bind is refused with
# ESME_RBINDFAIL rather than accepting traffic the server cannot deliver.
SMPP_SERVER_ENABLED=
SMPP_SERVER_HOST=
SMPP_SERVER_PORT=
SMPP_MAX_SESSIONS=
SMPP_ENQUIRE_LINK_INTERVAL=
SMPP_IDLE_TIMEOUT=
SMPP_SESSION_TTL=
SMPP_READ_CHUNK_BYTES=
SMPP_MAX_PDU_BYTES=
SMPP_ACCEPT_PAUSE=
SMPP_QUEUE=
SMPP_TRIES=
SMPP_TIMEOUT=
SMPP_DEFAULT_SOURCE=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (sign-in form)
# ---------------------------------------------------------------------------
# Leave TURNSTILE_ENABLED off for local work and the test suite: the challenge is
# only armed when the flag is on and both keys are filled in. Create the keys at
# https://dash.cloudflare.com/?to=/:account/turnstile — Cloudflare's test keys
# (site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA)
# always pass.
TURNSTILE_ENABLED=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=
TURNSTILE_TIMEOUT=

# ---------------------------------------------------------------------------
# Notification centre
# ---------------------------------------------------------------------------
# In-app notifications are always written; the email copy only leaves the
# platform for accounts that switched the category's email channel on. Email is
# on by default for billing and compliance only (config/notifications.php).
NOTIFICATIONS_ENABLED=
NOTIFICATIONS_QUEUE=
NOTIFICATIONS_PER_PAGE=
NOTIFICATIONS_BELL_ITEMS=
NOTIFICATIONS_ANNOUNCEMENT_CHUNK=
NOTIFICATIONS_READ_RETENTION_DAYS=
NOTIFICATIONS_SENT_RETENTION_DAYS=

# The SMS copy is opt-in twice: the account ticks the category's SMS channel and
# this switch is on, because every part is billed. The sender is the
# alphanumeric sender the short copy is submitted with, and the max length caps
# the composed body (title, body and link) before it is truncated.
NOTIFICATIONS_SMS_ENABLED=
NOTIFICATIONS_SMS_SENDER=
NOTIFICATIONS_SMS_MAX_LENGTH=

# ---------------------------------------------------------------------------
# Activity log
# ---------------------------------------------------------------------------
ACTIVITY_LOGGER_ENABLED=
ACTIVITY_LOGGER_DB_CONNECTION=
ACTIVITY_LOGGER_TABLE_NAME=
